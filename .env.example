# Direct-container settings for docker run --env-file.
# For wrapper server launches, forward these through CODEXBOX_ENV_*.
OPENAI_API_KEY=
CODEXBOX_WORKSPACE=/workspace
CODEXBOX_CONTAINER_NAME=codexbox
CODEXBOX_GIT_NAME=
CODEXBOX_GIT_EMAIL=
# Optional shared identity values override nonempty child aliases.
AICODEBOX_GIT_NAME=
AICODEBOX_GIT_EMAIL=

CODEXBOX_API_MODE=0
CODEXBOX_API_MODE_PORT=8080
CODEXBOX_API_MODE_TOKEN=
# Set the model IDs supported by your configured provider before API mode.
CODEXBOX_AVAILABLE_MODELS=
CODEXBOX_AVAILABLE_EFFORTS=
CODEXBOX_TELEGRAM_MODE=0
CODEXBOX_TELEGRAM_MODE_TOKEN=
CODEXBOX_TELEGRAM_MODE_CONFIG=
CODEXBOX_TELEGRAM_MODE_OVERRIDES=
CODEXBOX_CRON_MODE=0
CODEXBOX_CRON_MODE_FILE=
CODEXBOX_CRON_MODE_HISTORY_DIR=
CODEXBOX_MCP_MODE=0
CODEXBOX_MCP_MODE_PORT=8081
CODEXBOX_MCP_MODE_TOKEN=
CODEXBOX_MCP_MODE_ALLOWED_HOSTS=
CODEXBOX_MCP_MODE_ALLOWED_ORIGINS=
DEBUG=false
